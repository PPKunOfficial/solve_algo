#!/usr/bin/env bun
/**
 * lc-commit — commit a solution using metadata from its header or filename.
 *
 * Auto-detects the source:
 * - Files under a `luogu/` directory: extract `Pxxx` from the filename.
 * - Otherwise: read `@lc app=... id=... lang=...` from the file header.
 */

import { readFileSync, existsSync } from "fs";
import { parse, relative } from "path";

const META_RE = /@lc\s+app=\S+\s+id=(\d+)\s+lang=([^\s*]+)/;
const TITLE_RE = /\[(\d+)]\s+(.+?)\s*(?:\*\/)?$/gm;
const PROBLEM_RE = /^(P\d+)/i;

function repositoryRoot(cwd: string): string {
  const result = Bun.spawnSync(["git", "rev-parse", "--show-toplevel"], { cwd });
  if (result.exitCode !== 0) {
    console.error("lc-commit: 当前目录不在 Git 仓库中，或系统未安装 Git");
    process.exit(2);
  }
  return result.stdout.toString().trim();
}

function runGit(args: string[], cwd: string): string {
  const result = Bun.spawnSync(["git", ...args], { cwd });
  if (result.exitCode !== 0) {
    console.error(`lc-commit: Git 命令失败（退出码 ${result.exitCode}）`);
    process.exit(result.exitCode);
  }
  return result.stdout.toString();
}

function normalizeFilename(filePath: string): string | null {
  const stem = parse(filePath).name;
  if (!stem.includes(".")) return null;
  const newStem = stem.replace(".", "-", 1);
  return filePath.replace(stem, newStem);
}

function isLuogu(filePath: string, root: string): boolean {
  const rel = relative(root, filePath);
  return rel.split("/")[0].toLowerCase() === "luogu";
}

function luoguMessage(filePath: string): string {
  const stem = parse(filePath).name;
  const match = PROBLEM_RE.exec(stem);
  if (!match) {
    console.error(`lc-commit: 文件名无法提取洛谷题号（期望 Pxxx）：${filePath}`);
    process.exit(2);
  }
  return `luogu ${match[1].toUpperCase()}`;
}

function leetcodeMessage(filePath: string): string {
  const content = readFileSync(filePath, "utf-8");
  const header = content.split("\n").slice(0, 64).join("\n");

  const metaMatch = META_RE.exec(header);
  if (!metaMatch) {
    console.error(`lc-commit: 文件头缺少 @lc app=... id=... lang=...：${filePath}`);
    process.exit(2);
  }

  const [, problemId, language] = metaMatch;

  const titles = [...header.matchAll(TITLE_RE)];
  const title = titles.find(([_, id]) => id === problemId)?.[2]?.trim();
  if (!title) {
    console.error(`lc-commit: 文件头缺少 [${problemId}] 题目标题：${filePath}`);
    process.exit(2);
  }

  return `[${problemId}] ${title} ${language}`;
}

const args = process.argv.slice(2);
const dryRun = args.includes("--dry-run");
const fileArg = args.find((a) => !a.startsWith("--"));

if (!fileArg) {
  console.error("Usage: lc-commit <file> [--dry-run]");
  process.exit(2);
}

const root = repositoryRoot(process.cwd());
let filePath = fileArg.startsWith("/") ? fileArg : `${process.cwd()}/${fileArg}`;
filePath = filePath.replace(/\/+$/, "");

if (!existsSync(filePath)) {
  console.error(`lc-commit: 文件不存在：${filePath}`);
  process.exit(2);
}

let relativePath = relative(root, filePath);
let message: string;

if (isLuogu(filePath, root)) {
  message = luoguMessage(filePath);
} else {
  const newPath = normalizeFilename(filePath);
  if (newPath && newPath !== filePath) {
    Bun.write(newPath, readFileSync(filePath));
    // Remove old file if renamed
    if (newPath !== filePath) {
      Bun.spawnSync(["rm", filePath]);
    }
    filePath = newPath;
    relativePath = relative(root, filePath);
  }
  message = leetcodeMessage(filePath);
}

if (dryRun) {
  console.log(message);
  process.exit(0);
}

runGit(["add", "--", relativePath], root);
runGit(["commit", "--only", "-m", message, "--", relativePath], root);
