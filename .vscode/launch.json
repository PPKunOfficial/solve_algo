{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python 调试程序: 当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}"
        },
        {
            "name": "调试当前 Rust 程序",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--bin",
                    "${fileBasenameNoExtension}"
                ],
                "filter": {
                    "name": "${fileBasenameNoExtension}",
                    "kind": "bin"
                },
                "cwd": "${fileDirname}"
            },
            "args": [],
            "cwd": "${fileDirname}",
            "sourceLanguages": [
                "rust"
            ]
        },
        {
            "name": "调试当前 C++ 文件",
            "type": "lldb",
            "request": "launch",
            "preLaunchTask": "编译当前 C++ 文件",
            "program": "${fileDirname}/.build/${fileBasenameNoExtension}",
            "args": [],
            "cwd": "${fileDirname}",
            "sourceLanguages": [
                "cpp"
            ]
        },
        {
            "name": "调试当前 C 文件",
            "type": "lldb",
            "request": "launch",
            "preLaunchTask": "编译当前 C 文件",
            "program": "${fileDirname}/.build/${fileBasenameNoExtension}",
            "args": [],
            "cwd": "${fileDirname}",
            "sourceLanguages": [
                "c"
            ]
        }
    ]
}