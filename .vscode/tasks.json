{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "提交当前题解",
            "type": "process",
            "command": "${workspaceFolder}/scripts/lc-commit",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "预览当前 commit message",
            "type": "process",
            "command": "${workspaceFolder}/scripts/lc-commit",
            "args": [
                "--dry-run",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "编译当前 C++ 文件",
            "type": "shell",
            "command": "mkdir -p \"${fileDirname}/.build\" && clang++ -std=c++20 -Wall -Wextra -Wpedantic -g -O0 \"${file}\" -o \"${fileDirname}/.build/${fileBasenameNoExtension}\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "本地判题（当前文件）",
            "type": "shell",
            "command": "bun run \"${workspaceFolder}/scripts/lg-judge\" run \"${file}\"",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "showReuseMessage": false
            }
            },
        {
            "label": "从洛谷获取样例",
            "type": "shell",
            "command": "PID=$(echo \"${fileBasenameNoExtension}\" | grep -oE '^P[0-9]+'); bun run \"${workspaceFolder}/scripts/lg-judge\" fetch \"$PID\" \"${fileDirname}/testcases/$PID\"",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "提交到洛谷",
            "type": "shell",
            "command": "PID=$(echo \"${fileBasenameNoExtension}\" | grep -oE '^P[0-9]+'); bun run \"${workspaceFolder}/scripts/lg-judge\" auto \"${file}\" \"$PID\"",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "showReuseMessage": false
            }
         }
    ]
}
